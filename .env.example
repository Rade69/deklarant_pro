# ASYCUDA Pro - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Database Configuration
# Na Windows klijentima: IP adresa Ubuntu Server laptopa
# Primjer: DB_HOST=192.168.1.100
# Na razvoj mašini (Linux): DB_HOST=/var/run/postgresql (Unix socket)
DB_HOST=192.168.1.100
DB_PORT=5432
DB_NAME=asycuda_pro
DB_USER=asycuda_app
DB_PASSWORD=your_password_here

# Application Settings
DEBUG=False

# Optional Application Settings
# MAX_IMPORT_WORKERS=4
# STRICT_VALIDATION=True

# AI Agent — DeepSeek (primarni provider)
# Registruj se na https://platform.deepseek.com i kopiraj API key
DEEPSEEK_API_KEY=sk-...

# AI Agent — Groq (fallback)
# Registruj se na https://console.groq.com i kopiraj API key
GROQ_API_KEY=gsk_...

# AI Agent — Google Gemini (zadnji fallback)
# Registruj se na https://aistudio.google.com i kopiraj API key
GEMINI_API_KEY=AIza...

# Bezbjednost podataka — kontrola šta agent šalje eksternom LLM-u
# false (default, preporučeno) — imenа se maskiraju, JIB se nikad ne šalje
# true — puna poslovna imenа idu u LLM kontekst (koristiti SAMO za lokalni Ollama)
SEND_SENSITIVE_DATA=false

# Token budžet po sesiji — blokira kad se dostigne limit, resetuje pri ponovnom pokretanju
# 50000 tokena ≈ ~30-50 pitanja sa punim kontekstom deklaracije
SESSION_TOKEN_BUDGET=50000

# Identifikator klijenta za audit log u PostgreSQL (razlikuje klijente u centralnoj bazi)
# Svaki klijent treba jedinstvenu vrijednost — vidljivo u public.llm_audit tabeli
# Primjeri: klijent1, klijent2, firma_abc
CLIENT_NAME=klijent1
