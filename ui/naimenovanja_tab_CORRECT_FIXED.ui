  <property name="styleSheet">
   <string>/* ASYCUDA_PRO – Modern Material-ish QSS (Qt6 compatible)
   NOTE: Qt stylesheets do NOT support box-shadow/transition/filter.
*/

/* Base */
QWidget#NaimenovanjaTab {
    background: #F6F7FB;
    color: #1F2937;
    font-family: "Segoe UI", "Inter", "Noto Sans";
    font-size: 12px;
}

/* Generic inputs */
QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 4px 6px;
    selection-background-color: #93C5FD;
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #3B82F6;
}
QLineEdit:disabled, QPlainTextEdit:disabled, QTextEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background: #F1F5F9;
    color: #64748B;
    border: 1px solid #E2E8F0;
}

/* Buttons */
QPushButton {
    background: #E5E7EB;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 6px 12px;
    color: #111827;
}
QPushButton:hover { background: #EEF2F7; }
QPushButton:pressed { background: #DCE3EE; }
QPushButton:disabled { background: #F1F5F9; color: #94A3B8; border: 1px solid #E2E8F0; }

/* Primary action */
QPushButton#btn_snimi, QPushButton#btn_ok, QPushButton#btn_novo {
    background: #2563EB;
    border: 1px solid #1D4ED8;
    color: white;
    font-weight: 600;
}
QPushButton#btn_snimi:hover, QPushButton#btn_ok:hover, QPushButton#btn_novo:hover { background: #1D4ED8; }
QPushButton#btn_snimi:pressed, QPushButton#btn_ok:pressed, QPushButton#btn_novo:pressed { background: #1E40AF; }

/* Destructive */
QPushButton#btn_brisi {
    background: #FEE2E2;
    border: 1px solid #FCA5A5;
    color: #991B1B;
    font-weight: 600;
}
QPushButton#btn_brisi:hover { background: #FECACA; }
QPushButton#btn_brisi:pressed { background: #FCA5A5; color: #7F1D1D; }

/* Tabs */
QTabWidget::pane {
    border: 1px solid #CBD5E1;
    background: #FFFFFF;
    border-radius: 10px;
}
QTabBar::tab {
    background: #E5E7EB;
    border: 1px solid #CBD5E1;
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    padding: 8px 16px;
    margin-right: 6px;
    min-width: 100px;
}
QTabBar::tab:selected {
    background: #FFFFFF;
    font-weight: 600;
}
QTabBar::tab:hover { background: #EEF2F7; }

/* Panels (rubrika blocks) */
QFrame#frame_31_main {
    background: #EAF5EA;
    border: 1px solid #B7D7B7;
    border-radius: 10px;
}
QFrame#frame_32_39, QFrame#frame_32_39_container {
    background: #EAF2FB;
    border: 1px solid #B6CDEB;
    border-radius: 10px;
}
QFrame#frame_40_43 {
    background: #FFF1E6;
    border: 1px solid #F4C7A7;
    border-radius: 10px;
}
QFrame#frame_44_main {
    background: #EEF2F7;
    border: 1px solid #C7D2E0;
    border-radius: 10px;
}
QFrame#frame_45_46 {
    background: #E7F7F4;
    border: 1px solid #A7E3D7;
    border-radius: 10px;
}

/* Sidebar title bars */
QLabel#sidebar_31, QLabel#sidebar_44 {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2E7D32, stop:1 #1B5E20);
    color: white;
    font-weight: 700;
    padding: 8px 10px;
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
}

/* Rubrika headers (labels) */
QLabel#lbl_rubrika32, QLabel#lbl_rubrika33, QLabel#lbl_rubrika34, QLabel#lbl_rubrika35,
QLabel#lbl_rubrika36, QLabel#lbl_rubrika37, QLabel#lbl_rubrika38, QLabel#lbl_rubrika39 {
    color: #1D4ED8;
    font-weight: 600;
}
QLabel#lbl_rubrika40, QLabel#lbl_rubrika41, QLabel#lbl_rubrika42, QLabel#lbl_rubrika43 {
    color: #B45309;
    font-weight: 600;
}
QLabel#lbl_rubrika45, QLabel#lbl_rubrika46 {
    color: #0F766E;
    font-weight: 600;
}

/* Checkboxes */
QCheckBox { spacing: 8px; }
QCheckBox::indicator {
    width: 16px; height: 16px;
    border-radius: 4px;
    border: 1px solid #94A3B8;
    background: #FFFFFF;
}
QCheckBox::indicator:checked {
    background: #2563EB;
    border: 1px solid #1D4ED8;
}

/* Small helper labels */
QLabel#lbl_item_counter { color: #475569; font-weight: 600; }
</string>
