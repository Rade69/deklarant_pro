AdminView {
    background-color: #f3f6f8;
    color: #17324a;
}

AdminView QFrame#AdminSidebar {
    background-color: #e7eef3;
    border: none;
    border-right: 1px solid #b8cbd8;
}

AdminView QLabel#AdminSidebarTitle {
    background-color: #d9e5ed;
    border: none;
    border-bottom: 2px solid #7897ad;
    color: #17324a;
    font-size: 20px;
    font-weight: 700;
    padding: 0 26px;
}

AdminView QListWidget#AdminNavigation {
    background-color: #e7eef3;
    border: none;
    outline: none;
    padding: 12px 10px;
    font-size: 15px;
}

AdminView QListWidget#AdminNavigation::item {
    color: #244866;
    border: 1px solid transparent;
    border-radius: 6px;
    margin: 3px 0;
    padding: 13px 10px;
}

AdminView QListWidget#AdminNavigation::item:hover {
    background-color: #d8e5ed;
    border-color: #b4cad8;
}

AdminView QListWidget#AdminNavigation::item:selected {
    background-color: #3477a5;
    border-color: #2b648c;
    color: #ffffff;
    font-weight: 700;
}

AdminView QWidget#AdminContent {
    background-color: #f3f6f8;
}

AdminView QStackedWidget#AdminContentStack {
    background-color: #f3f6f8;
    border: none;
}

AdminView QLabel {
    color: #17324a;
    font-size: 13px;
}

AdminView QLabel#SectionTitle {
    color: #17324a;
    font-size: 20px;
    font-weight: 700;
    padding: 4px 2px 8px 2px;
}

AdminView QGroupBox,
AdminView QFrame#LicenseCard {
    background-color: #ffffff;
    border: 1px solid #bfd0dc;
    border-radius: 7px;
    color: #17324a;
    font-size: 14px;
    font-weight: 700;
    margin-top: 12px;
    padding-top: 10px;
}

AdminView QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 7px;
    color: #244866;
}

AdminView QPushButton {
    background-color: #4f6779;
    border: 1px solid #425868;
    border-radius: 5px;
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    min-height: 30px;
    min-width: 105px;
    padding: 5px 13px;
}

AdminView QPushButton:hover {
    background-color: #425868;
}

AdminView QPushButton:pressed {
    background-color: #354a59;
}

AdminView QPushButton:disabled {
    background-color: #d7e0e5;
    border-color: #c4d0d7;
    color: #8798a5;
}

AdminView QPushButton#primaryButton {
    background-color: #3477a5;
    border-color: #2b648c;
}

AdminView QPushButton#primaryButton:hover {
    background-color: #2b648c;
}

AdminView QPushButton#successButton {
    background-color: #2f7d5b;
    border-color: #286a4e;
}

AdminView QPushButton#successButton:hover {
    background-color: #286a4e;
}

AdminView QPushButton#dangerButton {
    background-color: #ad3e3e;
    border-color: #943535;
}

AdminView QPushButton#dangerButton:hover {
    background-color: #943535;
}

AdminView QLineEdit,
AdminView QComboBox,
AdminView QDateEdit,
AdminView QSpinBox {
    background-color: #ffffff;
    border: 1px solid #b8cbd8;
    border-radius: 4px;
    color: #17324a;
    font-size: 13px;
    min-height: 28px;
    padding: 3px 8px;
}

AdminView QLineEdit:focus,
AdminView QComboBox:focus,
AdminView QDateEdit:focus,
AdminView QSpinBox:focus {
    border: 2px solid #3477a5;
}

AdminView QTextEdit,
AdminView QPlainTextEdit {
    background-color: #f9fbfc;
    border: 1px solid #bfd0dc;
    border-radius: 5px;
    color: #17324a;
    font-size: 12px;
    padding: 7px;
}

AdminView QListWidget {
    background-color: #ffffff;
    border: 1px solid #bfd0dc;
    border-radius: 5px;
    color: #17324a;
    outline: none;
}

AdminView QListWidget::item {
    padding: 7px 9px;
}

AdminView QListWidget::item:hover {
    background-color: #e8f0f5;
}

AdminView QListWidget::item:selected {
    background-color: #3477a5;
    color: #ffffff;
}

AdminView QProgressBar {
    background-color: #dfe8ed;
    border: 1px solid #c3d2dc;
    border-radius: 5px;
    color: #17324a;
    text-align: center;
}

AdminView QProgressBar::chunk {
    background-color: #2f7d5b;
    border-radius: 4px;
}

AdminView QScrollArea {
    background-color: transparent;
    border: none;
}

AdminView QScrollBar:vertical {
    background-color: #e6edf2;
    border: none;
    margin: 0;
    width: 12px;
}

AdminView QScrollBar::handle:vertical {
    background-color: #8da7b8;
    border-radius: 5px;
    min-height: 32px;
}

AdminView QScrollBar::add-line:vertical,
AdminView QScrollBar::sub-line:vertical {
    height: 0;
}

AdminView QToolTip {
    background-color: #244866;
    border: 1px solid #17324a;
    color: #ffffff;
    padding: 5px 8px;
}
