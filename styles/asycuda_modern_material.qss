QGroupBox#group_32_39::title {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #42A5F5,
        stop:1 #64B5F6
    );
}

/* 40 Dokumenti - Narandžasta */
QGroupBox#group_40 {
    background-color: #FFF3E0;
    border: 2px solid #FFA726;
}

QGroupBox#group_40::title {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #FFA726,
        stop:1 #FFB74D
    );
}

/* 41-43 Dopunska/Cijena - Svetlo zelena */
QGroupBox#group_41_43 {
    background-color: #F1F8E9;
    border: 2px solid #9CCC65;
}

QGroupBox#group_41_43::title {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #9CCC65,
        stop:1 #AED581
    );
}

/* 44 Prilozi - Plava */
QGroupBox#group_44 {
    background-color: #E1F5FE;
    border: 2px solid #29B6F6;
}

QGroupBox#group_44::title {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #29B6F6,
        stop:1 #4FC3F7
    );
