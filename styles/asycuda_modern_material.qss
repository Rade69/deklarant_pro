/* 45-46 Vrijednosti - Tirkizna */
QGroupBox#group_45_46 {
    background-color: #E0F2F1;
    border: 2px solid #26A69A;
}

QGroupBox#group_45_46::title {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #26A69A,
        stop:1 #4DB6AC
    );
}
