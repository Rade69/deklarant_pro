/*
═══════════════════════════════════════════════════════════════
Deklarant Pro - Naimenovanja Tab Components
Centralized styles for Naimenovanja tab UI components
═══════════════════════════════════════════════════════════════
*/

/* ═══════════════════════════════════════════════════════════
   NAVIGATION BAR
   ═══════════════════════════════════════════════════════════ */

QWidget#navBar {
    background: #eef3f7;
    border-top: 1px solid #d6e0e8;
    border-bottom: 2px solid #9fb2c1;
}

/* Globalni QPushButton min-height (QSS_header_toolbar_sistem.qss) nadjacava
   setFixedHeight(30) na nav dugmicima (minimumHeight > maximumHeight), pa se
   dugme renderuje vise nego sto stane u navBar i prelazi u sectionHeading
   ispod. Ovo pravilo (ID selektor) ima vecu specificnost od globalnog. */
QWidget#navBar QPushButton {
    min-height: 16px;
    padding: 4px 14px;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 600;
}

/* Navigation labels (bold, dark text) */
QLabel.nav-label {
    font-weight: 600;
    color: #212529;
    font-size: 14px;
}

/* Navigation counter (lighter, gray) */
QLabel.nav-counter {
    color: #1a1a2e;
    font-size: 13px;
    font-weight: 700;
    margin-left: 4px;
}

/* Dropdown selector in navigation */
QComboBox[class="nav-combo"] {
    padding: 5px 10px;
    border: 1px solid #9fb2c1;
    border-radius: 4px;
    background: white;
    font-size: 13px;
}
QWidget#navBar QPushButton#btnPrethodno,
QWidget#navBar QPushButton#btnSljedece,
QWidget#navBar QPushButton#btnDodaj,
QWidget#navBar QPushButton#btnUveziXMLNaim,
QWidget#navBar QPushButton#btnInspekcije {
    background-color: #52697a;
    color: #ffffff;
    border: none;
}

QWidget#navBar QPushButton#btnObrisi {
    background-color: #a6403d;
    color: #ffffff;
    border: none;
}

QWidget#navBar QPushButton#btnAutoPopuni {
    background-color: #6a55a3;
    color: #ffffff;
    border: none;
}

QWidget#navBar QPushButton#btnPrethodno:hover,
QWidget#navBar QPushButton#btnSljedece:hover,
QWidget#navBar QPushButton#btnDodaj:hover,
QWidget#navBar QPushButton#btnUveziXMLNaim:hover,
QWidget#navBar QPushButton#btnInspekcije:hover {
    background-color: #607b8e;
}

QWidget#navBar QPushButton#btnObrisi:hover {
    background-color: #b9514d;
}

QWidget#navBar QPushButton#btnAutoPopuni:hover {
    background-color: #59458d;
}

QWidget#navBar QPushButton#btnPrethodno:pressed,
QWidget#navBar QPushButton#btnSljedece:pressed,
QWidget#navBar QPushButton#btnDodaj:pressed,
QWidget#navBar QPushButton#btnUveziXMLNaim:pressed,
QWidget#navBar QPushButton#btnInspekcije:pressed {
    background-color: #405563;
}

QWidget#navBar QPushButton#btnObrisi:pressed {
    background-color: #85322f;
}

QWidget#navBar QPushButton#btnAutoPopuni:pressed {
    background-color: #493875;
}

QWidget#navBar QPushButton:pressed {
    padding-top: 5px;
    padding-bottom: 3px;
}


QComboBox[class="nav-combo"]:focus {
    border: 2px solid #3f7898;
}

/* ═══════════════════════════════════════════════════════════
   SECTION HEADING
   ═══════════════════════════════════════════════════════════ */

QWidget#sectionHeading {
    background: #2c3e50;
    color: white;
}

QWidget#sectionHeading QPushButton {
    min-height: 16px;
    padding: 3px 12px;
    border-radius: 4px;
}

QWidget#sectionHeading QPushButton#btnSnimi {
    background-color: #2f7d5a;
    color: #ffffff;
    border: none;
}

QWidget#sectionHeading QPushButton#btnSnimi:hover {
    background-color: #3b906b;
}

QWidget#sectionHeading QPushButton#btnSnimi:pressed {
    background-color: #256347;
}

QWidget#sectionHeading QPushButton#btnIzlaz {
    background-color: #52697a;
    color: #ffffff;
    border: none;
}

QWidget#sectionHeading QPushButton#btnIzlaz:hover {
    background-color: #607b8e;
}

QWidget#sectionHeading QPushButton#btnIzlaz:pressed {
    background-color: #405563;
}

/* Section heading label ("📋 Naimenovanje #X") */
QLabel.section-heading-label {
    color: white;
    font-size: 15px;
    font-weight: bold;
}

/* ═══════════════════════════════════════════════════════════
   SUMMARY PANEL METRICS
   ═══════════════════════════════════════════════════════════ */

QWidget#summaryPanel {
    /* Gradient background stays INLINE in Python code */
}

/* Summary metric labels (white text on gradient background) */
QLabel.summary-metric {
    color: white;
    font-size: 13px;
    font-weight: 600;
}

/* Status badge in summary panel */
QLabel.summary-status-badge {
    background: rgba(255, 255, 255, 0.25);
    color: white;
    padding: 8px 16px;
    border-radius: 4px;
    font-weight: bold;
    font-size: 13px;
}

/* ═══════════════════════════════════════════════════════════
   UI FORM ELEMENTS (Grid Scaling)
   ═══════════════════════════════════════════════════════════ */

/* Applies to .ui loaded forms - QGroupBox backgrounds */
QWidget#naimenovanjaUiWidget QGroupBox {
    font-size: 13px;
    font-weight: bold;
    background-color: #e8f5e9;
    color: #333;
}

QWidget#naimenovanjaUiWidget QLabel {
    font-size: 14px;
    font-weight: bold;
    color: #2e7d32;
}

QWidget#naimenovanjaUiWidget QLineEdit {
    font-size: 14px;
    padding: 4px;
    color: #333;
    background-color: white;
}

QGroupBox#group_31 {
    background-color: #edf7ef;
}

QLabel#lbl_rubrika31 {
    background-color: #d8ebdd;
    color: #1f5d35;
    border-radius: 4px;
    padding-left: 4px;
}

QLabel#lbl_r31_oznake {
    color: #1f5d35;
    font-size: 14px;
    font-weight: 700;
}

QLineEdit#le_r31_oznake_br,
QLineEdit#le_r31_paketa,
QLineEdit#le_r31_broj {
    border: 1px solid #b7c9bd;
    border-radius: 4px;
}

QLineEdit#le_r31_oznake_br:focus,
QLineEdit#le_r31_paketa:focus,
QLineEdit#le_r31_broj:focus {
    border: 2px solid #3f7898;
}

/* Rubrike 32-39: kompaktan blok tarifnih i carinskih podataka */
QGroupBox#group_32_39 {
    background-color: #edf3ef;
    border: 1px solid #83988b;
}

QGroupBox#group_32_39 > QLabel {
    color: #245f45;
    font-weight: 700;
}

QGroupBox#group_32_39 > QLineEdit {
    background-color: #ffffff;
    border: 1px solid #a8b9ae;
    border-radius: 4px;
    color: #26352d;
}

QGroupBox#group_32_39 > QLineEdit:hover {
    border-color: #789383;
}

QGroupBox#group_32_39 > QLineEdit:focus {
    border: 2px solid #2f7d5a;
    background-color: #fbfefc;
}

QGroupBox#group_32_39 > QLineEdit:read-only {
    background-color: #f2f5f3;
    color: #526159;
}


QLineEdit#le_r31_vrsta_naziv {
    background-color: #e3f2fd;
    border: 2px solid #2196f3;
    border-radius: 4px;
    padding: 3px 6px;
    font-weight: bold;
    font-size: 14px;
    color: #1565c0;
}

QWidget#naimenovanjaUiWidget QComboBox {
    font-size: 14px;
    color: #333;
}

QWidget#naimenovanjaUiWidget QComboBox QLineEdit {
    color: #333;
}

/* ═══════════════════════════════════════════════════════════
   NAVIGATION & ACTION BUTTONS
   ═══════════════════════════════════════════════════════════ */

QPushButton#btnPrevItem, QPushButton#btnNextItem,
QPushButton#btnPrevRecord, QPushButton#btnNextRecord {
    background-color: #3A7BD5;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 5px 12px;
    font-size: 13px;
    font-weight: 500;
    min-height: 28px;
    min-width: 60px;
}

QPushButton#btnPrevItem:hover, QPushButton#btnNextItem:hover,
QPushButton#btnPrevRecord:hover, QPushButton#btnNextRecord:hover {
    background-color: #2E63B3;
}

QPushButton#btnPrevItem:pressed, QPushButton#btnNextItem:pressed,
QPushButton#btnPrevRecord:pressed, QPushButton#btnNextRecord:pressed {
    background-color: #254F91;
}

QWidget#naimenovanjaUiWidget QTextEdit {
    font-size: 13px;
}

/* ═══════════════════════════════════════════════════════════
   COMBO BOXES — STATIC STYLES
   (Dynamic/error styles must remain inline)
   ═══════════════════════════════════════════════════════════ */

/* Rb.31 Vrsta pakovanja dropdown */
QComboBox#le_r31_vrsta {
    border: 2px solid #28a745;
    border-radius: 6px;
    padding: 5px 15px;
    background-color: #ffffff;
    font-size: 14px;
    font-weight: 500;
    min-width: 80px;
}

QComboBox#le_r31_vrsta:hover {
    border: 2px solid #4a90e2;
}

QComboBox#le_r31_vrsta:focus {
    border: 2px solid #4a90e2;
    background-color: #f8faff;
}

QComboBox#le_r31_vrsta:editable {
    background-color: #ffffff;
}

QComboBox#le_r31_vrsta::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left: 1px solid #28a745;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

/* CSS triangle arrow for le_r31_vrsta */
QComboBox#le_r31_vrsta::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
    margin-right: 6px;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 7px solid #4a4a4a;
}

QComboBox#le_r31_vrsta QAbstractItemView {
    border: 1px solid #4a90e2;
    selection-background-color: #4a90e2;
    selection-color: white;
    background-color: #ffffff;
    outline: 0px;
    border-radius: 6px;
    padding: 5px;
    font-size: 14px;
    min-width: 600px;
}

QComboBox#le_r31_vrsta QAbstractItemView::item {
    height: 30px;
    padding-left: 10px;
    border-radius: 4px;
    margin: 2px 5px;
}

QComboBox#le_r31_vrsta QAbstractItemView::item:hover {
    background-color: #e8f0fe;
    color: #1a73e8;
}

/* ═══════════════════════════════════════════════════════════
   NAVIGATION COMBO
   ═══════════════════════════════════════════════════════════ */

/* Navigation dropdown - uses dynamic property class="nav-combo" */
QComboBox[class="nav-combo"] {
    font-size: 14px;
    font-weight: 600;
    padding: 4px 10px;
    border: 2px solid #4A7FA5;
    border-radius: 5px;
    background: white;
    color: #1a1a2e;
}

QComboBox[class="nav-combo"]:focus {
    border-color: #2563eb;
    background: #f0f7ff;
}

QComboBox[class="nav-combo"]::drop-down {
    width: 28px;
    border-left: 1px solid #4A7FA5;
}

/* CSS triangle arrow for nav-combo */
QComboBox[class="nav-combo"]::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
    margin-right: 6px;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 7px solid #4a4a4a;
}

/* ═══════════════════════════════════════════════════════════
   TARIFF WARNING LABEL
   ═══════════════════════════════════════════════════════════ */

QLabel#lbl_tariff_warning {
    background-color: #FF8C00;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 14px;
    padding: 2px 10px;
    border-radius: 4px;
    border: 1px solid #CC6600;
}

/* ═══════════════════════════════════════════════════════════
   TRGOVAČKI NAZIV (Rb.31)
   ═══════════════════════════════════════════════════════════ */

QTextEdit#le_r31_trg_naziv {
    background-color: #e3f2fd;
    border: 2px solid #2196f3;
    border-radius: 4px;
    padding: 5px;
    font-size: 14px;
    font-weight: 600;
    color: #1565c0;
}

/* ═══════════════════════════════════════════════════════════
   MAIN GRID FRAME
   ═══════════════════════════════════════════════════════════ */

QFrame#main_grid_frame {
    background-color: #f0f0f0;
    border: 1px solid #999;
}

/* ═══════════════════════════════════════════════════════════
   TARIFF DESCRIPTION FIELDS (Rb.31 podbroj/glava)
   Base styles - colored highlight applied at runtime via Python
   ═══════════════════════════════════════════════════════════ */

/* Podbroj (te_r31_opis) - base styling */
QLineEdit#te_r31_opis {
    border-radius: 4px;
    padding: 3px 6px;
    font-weight: bold;
    font-size: 14px;
}

/* Heading (te_r31_opis_2) - base styling */
QLineEdit#te_r31_opis_2 {
    border-radius: 4px;
    padding: 3px 6px;
    font-weight: bold;
    font-size: 14px;
}
