/*
═══════════════════════════════════════════════════════════════
Deklarant Pro - Main Tabs Styling
Styling za glavne tabove aplikacije (Faktura, Zaglavlje, Naimenovanja, Šifrarnici)

VAŽNO: Bez background-color na QTabWidget::pane — svaka tab stranica
crta vlastitu pozadinu (QPalette). background-color: white bi pregazio
zelene i druge pozadine tab widgeta.
═══════════════════════════════════════════════════════════════
*/

/* Tab widget pane — samo border, BEZ background-color
   border-top je uklonjen jer se inače crta preko donjeg dijela
   trake tabova (sjeklo ikonice/tekst neaktivnih tabova) */
QTabWidget::pane {
    border: 2px solid #0078d4;
    border-top: none;
    border-radius: 8px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
}

/* Individual tab — border na sve 4 strane, zaokruženi uglovi na svim
   stranama (konzistentan izgled, "floating" tab) */
QTabBar::tab {
    background-color: #f0f0f0;
    border: 2px solid #0078d4;
    border-radius: 8px;
    padding: 12px 24px;
    margin-right: 4px;
    font-size: 16px;
    font-weight: bold;
    color: #333;
    min-width: 150px;
}

/* Active (selected) tab */
QTabBar::tab:selected {
    background-color: #0078d4;
    color: white;
    border-bottom: 2px solid #0078d4;
}

/* Hover effect */
QTabBar::tab:hover:!selected {
    background-color: #e0e0e0;
}

QPushButton#btnExitApp {
    background-color: #3D6A8A;
    color: #FFFFFF;
    border: 1px solid #2D506B;
    border-radius: 6px;
    padding: 3px 14px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#btnExitApp:hover:enabled {
    background-color: #568FB7;
    border: 2px solid #F2C14E;
}

QPushButton#btnExitApp:pressed {
    background-color: #2D506B;
    border-color: #1E3A4F;
}

/* Kontekstni meniji — spriječi nasljeđivanje color:white od tab selektora */
QMenu {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #bdc3c7;
}

QMenu::item:selected {
    background-color: #0078d4;
    color: white;
}

QMenu::item:disabled {
    color: #aaaaaa;
}
