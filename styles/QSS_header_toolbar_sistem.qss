/* =========================
   GLOBAL
========================= */

QMainWindow {
    background: #F7F9FC;
    font-family: "Segoe UI", "Ubuntu", "DejaVu Sans", sans-serif;
    font-size: 13px;
}


/* =========================
   TAB BAR (Faktura / Naimenovanja / ...)
========================= */

QTabBar::tab {
    background: #EAF2FF;
    color: #1F2937;
    padding: 6px 12px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-size: 13px;
}

QTabBar::tab:selected {
    background: #2563EB;
    color: white;
    font-weight: 600;
}

QTabBar::tab:hover {
    background: #D6E4FF;
}


/* =========================
   TOOLBAR CONTAINER
========================= */

QToolBar {
    background: #FFFFFF;
    border: none;
    spacing: 6px;
    padding: 4px;
}


/* =========================
   BASE BUTTON STYLE
========================= */

QPushButton {
    border-radius: 6px;
    padding: 5px 12px;
    font-weight: 500;
    border: 1px solid transparent;
    min-height: 28px;
}

QPushButton:disabled {
    background: #E5E7EB;
    color: #9CA3AF;
    border: 1px solid #D1D5DB;
}


/* =========================
   GREEN — UVEZI / SNIMI
========================= */

QPushButton#importBtn,
QPushButton#snimiBtn,
QPushButton#xmlBtn {
    background: #E8F5E9;
    color: #1B5E20;
    border: 1px solid #A5D6A7;
}

QPushButton#importBtn:hover,
QPushButton#snimiBtn:hover,
QPushButton#xmlBtn:hover {
    background: #C8E6C9;
}

QPushButton#importBtn:pressed,
QPushButton#snimiBtn:pressed,
QPushButton#xmlBtn:pressed {
    background: #81C784;
    color: white;
}

QPushButton#importBtn:disabled,
QPushButton#snimiBtn:disabled,
QPushButton#xmlBtn:disabled {
    background: #F1F8E9;
    color: #A5D6A7;
    border: 1px solid #C5E1A5;
}


/* =========================
   PRIMARY GREEN (MAIN ACTION)
========================= */

QPushButton#primaryGreen {
    background: #2E7D32;
    color: white;
    font-weight: 600;
}

QPushButton#primaryGreen:hover {
    background: #1B5E20;
}

QPushButton#primaryGreen:pressed {
    background: #145A18;
}

QPushButton#primaryGreen:disabled {
    background: #81C784;
    color: #C8E6C9;
}


/* =========================
   ORANGE — KREIRAJ NAIMENOVANJA
========================= */

QPushButton#createNaimenovanjaBtn {
    background: #edba8c;
    color: #5D2E00;
    font-weight: 600;
    border: 1px solid #d9a875;
}

QPushButton#createNaimenovanjaBtn:hover {
    background: #e0a875;
}

QPushButton#createNaimenovanjaBtn:pressed {
    background: #d4965e;
    color: white;
}

QPushButton#createNaimenovanjaBtn:disabled {
    background: #f5d9bc;
    color: #c4a98a;
    border: 1px solid #e8c8a9;
}


/* =========================
   YELLOW — UREDI
========================= */

QPushButton#editBtn {
    background: #FFF8E1;
    color: #8D6E00;
    border: 1px solid #FFE082;
}

QPushButton#editBtn:hover {
    background: #FFECB3;
}

QPushButton#editBtn:pressed {
    background: #FFD54F;
}

QPushButton#editBtn:disabled {
    background: #FFFBF0;
    color: #D4C39A;
    border: 1px solid #FFE7A6;
}


/* =========================
   ORANGE — IZVEZI
========================= */

QPushButton#exportBtn {
    background: #FFF3E0;
    color: #E65100;
    border: 1px solid #FFCC80;
}

QPushButton#exportBtn:hover {
    background: #FFE0B2;
}

QPushButton#exportBtn:pressed {
    background: #FFB74D;
    color: white;
}

QPushButton#exportBtn:disabled {
    background: #FFF9F0;
    color: #FFCCAA;
    border: 1px solid #FFD9A0;
}


/* =========================
   PURPLE — SMART / AUTO
========================= */

QPushButton#smartBtn {
    background: #F3E5F5;
    color: #4A148C;
    border: 1px solid #CE93D8;
}

QPushButton#smartBtn:hover {
    background: #E1BEE7;
}

QPushButton#smartBtn:pressed {
    background: #BA68C8;
    color: white;
}

QPushButton#smartBtn:disabled {
    background: #F9F5FA;
    color: #D8C4DD;
    border: 1px solid #E0C1E8;
}


/* =========================
   DANGER — DELETE
========================= */

QPushButton#dangerBtn {
    background: #FDECEA;
    color: #B71C1C;
    border: 1px solid #EF9A9A;
}

QPushButton#dangerBtn:hover {
    background: #F8BBD0;
}

QPushButton#dangerBtn:pressed {
    background: #D32F2F;
    color: white;
}

QPushButton#dangerBtn:disabled {
    background: #FEF5F4;
    color: #F5B7B7;
    border: 1px solid #F8C9C9;
}


/* =========================
   INPUT FIELDS (QLineEdit)
========================= */

QLineEdit {
    background: white;
    border: 1px solid #C5D2E8;
    border-radius: 5px;
    padding: 6px;
    color: #1F2937;
    selection-background-color: #DBEAFE;
    selection-color: #1E40AF;
}

QLineEdit:focus {
    border: 1px solid #2563EB;
    background: #FAFBFF;
}

QLineEdit:disabled {
    background: #F3F4F6;
    color: #9CA3AF;
    border: 1px solid #D1D5DB;
}

QLineEdit[readOnly="true"] {
    background: #F9FAFB;
    color: #4B5563;
    border: 1px solid #E5E7EB;
}


/* =========================
   TEXT EDIT (QTextEdit) - Multi-line
========================= */

QTextEdit {
    background: white;
    border: 1px solid #C5D2E8;
    border-radius: 5px;
    padding: 6px;
    color: #1F2937;
    selection-background-color: #DBEAFE;
    selection-color: #1E40AF;
}

QTextEdit:focus {
    border: 1px solid #2563EB;
    background: #FAFBFF;
}

QTextEdit:disabled {
    background: #F3F4F6;
    color: #9CA3AF;
    border: 1px solid #D1D5DB;
}

QTextEdit[readOnly="true"] {
    background: #F9FAFB;
    color: #4B5563;
    border: 1px solid #E5E7EB;
}


/* =========================
   LABEL
========================= */

QLabel {
    color: #374151;
}

QLabel:disabled {
    color: #9CA3AF;
}


/* =========================
   GROUP HEADER STRIPES
========================= */

QFrame#sectionUvezi {
    background: #E8F5E9;
    border-radius: 6px;
}

QFrame#sectionUredi {
    background: #FFF8E1;
    border-radius: 6px;
}

QFrame#sectionIzvezi {
    background: #FFF3E0;
    border-radius: 6px;
}

QFrame#sectionSmart {
    background: #F3E5F5;
    border-radius: 6px;
}


/* =========================
   TABLE WIDGET
========================= */

QTableWidget,
QTableView {
    background: white;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    gridline-color: #E5E7EB;
    selection-background-color: #DBEAFE;
    selection-color: #1E40AF;
}

QTableWidget::item,
QTableView::item {
    padding: 6px;
    border: none;
    color: #000000;
}

QTableWidget::item:selected,
QTableView::item:selected {
    background: #DBEAFE;
    color: #1E40AF;
}

QTableWidget::item:hover,
QTableView::item:hover {
    background: #F3F4F6;
}

QHeaderView::section {
    background: #F9FAFB;
    color: #374151;
    padding: 8px;
    border: none;
    border-bottom: 2px solid #E5E7EB;
    border-right: 1px solid #E5E7EB;
    font-weight: 600;
}

QHeaderView::section:hover {
    background: #F3F4F6;
}


/* =========================
   SCROLLBAR - Vertical
========================= */

QScrollBar:vertical {
    background: #F3F4F6;
    width: 12px;
    border-radius: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #D1D5DB;
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #9CA3AF;
}

QScrollBar::handle:vertical:pressed {
    background: #6B7280;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}


/* =========================
   SCROLLBAR - Horizontal
========================= */

QScrollBar:horizontal {
    background: #F3F4F6;
    height: 12px;
    border-radius: 6px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #D1D5DB;
    border-radius: 6px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #9CA3AF;
}

QScrollBar::handle:horizontal:pressed {
    background: #6B7280;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}


/* =========================
   COMBO BOX
========================= */

QComboBox {
    background: white;
    border: 1px solid #C5D2E8;
    border-radius: 5px;
    padding: 6px 10px;
    color: #1F2937;
    font-size: 13px;
    min-width: 100px;
}

QComboBox:hover {
    border: 1px solid #9CA3AF;
}

QComboBox:focus {
    border: 1px solid #2563EB;
}

QComboBox:disabled {
    background: #F3F4F6;
    color: #9CA3AF;
    border: 1px solid #D1D5DB;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #6B7280;
    width: 0;
    height: 0;
}

QComboBox QAbstractItemView {
    background: white;
    color: #1F2937;
    font-size: 13px;
    border: 1px solid #C5D2E8;
    border-radius: 4px;
    selection-background-color: #DBEAFE;
    selection-color: #1E40AF;
    padding: 2px;
    outline: 0;
}

QComboBox QAbstractItemView::item {
    padding: 5px 10px;
    min-height: 24px;
}

QComboBox QAbstractItemView::item:hover {
    background: #EFF6FF;
    color: #1E40AF;
}

QComboBox QAbstractItemView::item:selected {
    background: #DBEAFE;
    color: #1E40AF;
}


/* =========================
   SPIN BOX
========================= */

QSpinBox,
QDoubleSpinBox {
    background: white;
    border: 1px solid #C5D2E8;
    border-radius: 5px;
    padding: 6px;
    color: #1F2937;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #2563EB;
}

QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background: #F3F4F6;
    color: #9CA3AF;
    border: 1px solid #D1D5DB;
}


/* =========================
   CHECKBOX & RADIO BUTTON
========================= */

QCheckBox,
QRadioButton {
    color: #374151;
    spacing: 6px;
}

QCheckBox:disabled,
QRadioButton:disabled {
    color: #9CA3AF;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #C5D2E8;
    background: white;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border: 2px solid #2563EB;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background: #2563EB;
    border: 2px solid #2563EB;
}

QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled {
    background: #F3F4F6;
    border: 2px solid #D1D5DB;
}
